---
import '../styles/landing.css';
import Header from '../components/header.astro';
import Features from '../components/home/features.astro';
import CodeExamples from '../components/home/code-examples.astro';
import Hero from '../components/home/hero.astro';
import VideoDemo from '../components/home/video-demo.astro';
import Footer from '../components/footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>beautiful-image - Compress images without sacrificing quality</title>
    <meta
      name="description"
      content="Compress and optimize images with minimal quality loss in the browser or on the server. Powered by Rust/WASM with zero native dependencies."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#080808] text-white antialiased">
    <Header />
    <Hero />
    <VideoDemo />
    <Features />
    <CodeExamples />
    <Footer />
  </body>
</html>
