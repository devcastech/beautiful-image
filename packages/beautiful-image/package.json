  "license": "MIT",
  "files": [
    "dist",
    "wasm",
    "LICENSE"
  ],
  "main": "./dist/beautiful-image.cjs",
  "module": "./dist/beautiful-image.js",
  "types": "./dist/beautiful-image.d.ts",
  "exports": {
    ".": {
      "types": "./dist/beautiful-image.d.ts",
